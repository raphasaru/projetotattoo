---
import Layout from '../layouts/Layout.astro';
import Portfolio from '../components/Portfolio.astro';
import Instructors from '../components/Instructors.astro';

const WA_LINK = "https://api.whatsapp.com/send?phone=5511913473446&text=Gostaria%20de%20saber%20mais%20sobre%20o%20Fundamentos%20da%20Tatuagem";

const aulas = [
  {
    day: "AULA 1",
    title: "Máquinas",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>`,
    items: [
      "Tipos de máquina rotativa e bobina",
      "Configurações para traço, sombra e pintura",
      "O que vale a pena comprar quando você está começando",
      "Prática: firmeza, velocidade e profundidade"
    ]
  },
  {
    day: "AULA 2",
    title: "Tintas & Pigmentos",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10"/><path d="M12 2v10l4.5 4.5"/></svg>`,
    items: [
      "Tintas, pigmentos, cores e marcas",
      "Diluentes e como usá-los corretamente",
      "Prática: preenchimento sólido blocado",
      "Prática: sombra suave e degradê"
    ]
  },
  {
    day: "AULA 3",
    title: "Agulhas",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="3"/></svg>`,
    items: [
      "Tipos de agulha e configurações",
      "Como escolher a agulha certa para cada técnica",
      "Prática: colorido, degradê e transições de cor",
      "Mistura de cores aplicada"
    ]
  },
  {
    day: "AULA 4",
    title: "Biossegurança",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>`,
    items: [
      "Cuidados básicos e normas sanitárias",
      "Contaminação cruzada: como evitar",
      "EPIs obrigatórios e como usá-los",
      "Responsabilidade profissional"
    ]
  },
  {
    day: "AULA 5",
    title: "Produtos & Certificado",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M9 8V6a3 3 0 016 0v2"/><path d="M12 13v3M10.5 13h3"/></svg>`,
    items: [
      "Marcas, stêncil e preparação da pele",
      "Cuidados pós-tattoo para orientar seus clientes",
      "Lista definitiva de materiais para montar seu kit",
      "Entrega do certificado de conclusão"
    ]
  }
];

const includes = [
  { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4"/><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`, text: "7 sábados de aula prática, das 16h às 19h (21h no total)" },
  { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>`, text: "Certificado de conclusão reconhecido" },
  { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg>`, text: "Mapa de estudos para continuar em casa" },
  { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>`, text: "Lista de materiais certos para comprar" },
  { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`, text: "Aulas com profissionais do mercado" },
  { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`, text: "Suporte no WhatsApp durante o curso" },
  { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>`, text: "Kit de prática cedido para usar em casa" },
];

const faqs = [
  {
    q: "Preciso ter experiência ou saber desenhar?",
    a: "Não. O Fundamentos foi feito para quem está começando do zero. Você não precisa ter experiência com tatuagem nem ser bom em desenho. Tudo é ensinado do início."
  },
  {
    q: "Quanto tempo dura o curso?",
    a: "São 7 sábados de aula presencial, das 16h às 19h (21h no total). Você sai com os fundamentos completos e um mapa de estudos para continuar evoluindo após o curso."
  },
  {
    q: "Vou praticar durante o curso?",
    a: "Sim. Cada aula combina teoria com prática no artificial. Você sai tendo praticado traço, preenchimento sólido, sombra, degradê e colorido, e com um mapa de estudos para continuar em casa."
  },
  {
    q: "Tem certificado?",
    a: "Sim. Na última aula você recebe o certificado de conclusão do Projeto Tattoo, com 13 anos de tradição no mercado de tatuagem profissional."
  },
  {
    q: "Como funciona o pagamento?",
    a: "Aceitamos parcelamento no cartão de crédito. Fale com a gente no WhatsApp para saber os valores atuais e condições disponíveis."
  },
  {
    q: "Onde fica a escola?",
    a: "R. Alferes Magalhães, 92 - Sala 137 - Santana, São Paulo - SP."
  },
  {
    q: "Como funciona o material para praticar em casa?",
    a: "Durante o curso você recebe em consignação um kit com máquina e materiais básicos para treinar em casa, entre uma aula e outra. Você assina um contrato simples de empréstimo e devolve o kit no penúltimo sábado de aula."
  }
];

const stats = [
  { number: "13", label: "Anos de tradição" },
  { number: "8mil+", label: "Alunos formados" },
  { number: "5Mi+", label: "Views no YouTube" },
  { number: "7", label: "Países com ex-alunos" },
];
---

<Layout
  title="Fundamentos da Tatuagem | Curso Presencial aos Sábados | Projeto Tattoo"
  description="Curso presencial de fundamentos da tatuagem aos sábados: aprenda máquinas, tintas, agulhas e biossegurança na prática, com kit cedido para treinar em casa. Certificado incluso. Projeto Tattoo, 13 anos formando profissionais."
>
  <main>

    <!-- ─── HERO (DARK) ──────────────────────────────────── -->
    <section class="hero-section">
      <div class="hero-bg-glow glow-1"></div>
      <div class="hero-bg-glow glow-2"></div>
      <div class="dot-grid"></div>

      <div class="container hero-inner">
        <div class="hero-content">
          <img
            src="/images/projeto-tattoo-logo-dourado.webp"
            alt="Projeto Tattoo"
            class="hero-logo"
            fetchpriority="high"
          />

          <span class="hero-badge reveal">
            <span class="badge-pulse"></span>
            Novo curso presencial · Vagas abertas
          </span>

          <h1 class="hero-headline reveal delay-1">
            A base que todo<br/>
            <span class="gold-text">tatuador precisa</span><br/>
            para começar certo
          </h1>

          <p class="hero-sub reveal delay-2">
            7 sábados de aula prática (16h às 19h) para dominar os fundamentos da tatuagem:
            máquinas, tintas, agulhas, biossegurança e produtos.
            Saia com certificado, um mapa de estudos e um kit para praticar em casa.
          </p>

          <a href={WA_LINK} target="_blank" rel="noopener" class="cta-btn reveal delay-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Garantir minha vaga
          </a>

          <div class="hero-trust reveal delay-4">
            <div class="trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4"/><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Não precisa de experiência prévia</span>
            </div>
            <div class="trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
              <span>Certificado incluso</span>
            </div>
            <div class="trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
              <span>Mapa de estudos</span>
            </div>
            <div class="trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
              <span>Kit para praticar em casa</span>
            </div>
          </div>
        </div>

        <div class="hero-visual reveal delay-2">
          <div class="hero-card-stack">
            <div class="day-preview-card">
              <span class="day-label">7 sábados</span>
              <p class="day-title">16h às 19h · 21h no total</p>
              <div class="day-modules">
                <span>Máquinas</span>
                <span>Tintas</span>
                <span>Agulhas</span>
                <span>Biossegurança</span>
                <span>Produtos</span>
              </div>
            </div>
            <div class="cert-preview-card">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              <div>
                <p class="cert-label">Certificado</p>
                <p class="cert-sub">Projeto Tattoo · 13 anos</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-divider"></div>
    </section>

    <!-- ─── PARA QUEM É (LIGHT) ──────────────────────────── -->
    <section class="for-who-section light-section">
      <div class="container">
        <div class="section-header center">
          <span class="section-label-gold">Para quem é esse curso</span>
          <h2 class="section-title dark-text">Você se identifica com algum desses pontos?</h2>
        </div>

        <div class="pain-grid">
          <div class="pain-card reveal">
            <div class="pain-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            </div>
            <p>"Quero tatuar mas não sei por onde começar: máquina, agulha, tinta... dá um nó na cabeça."</p>
          </div>
          <div class="pain-card reveal" style="transition-delay:0.1s">
            <div class="pain-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <p>"Tenho medo de gastar dinheiro com material errado antes de entender o que realmente preciso."</p>
          </div>
          <div class="pain-card reveal" style="transition-delay:0.2s">
            <div class="pain-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <p>"Quero ter certeza de que é isso antes de me comprometer com algo mais longo. Preciso de um ponto de entrada."</p>
          </div>
          <div class="pain-card reveal" style="transition-delay:0.3s">
            <div class="pain-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 3a3 3 0 0 1 0 6h-6a3 3 0 0 1 0-6z"/><path d="M6 21a3 3 0 0 1 0-6h6a3 3 0 0 1 0 6z"/></svg>
            </div>
            <p>"Fico adiando porque sinto que preciso de uma base primeiro: algum lugar para realmente começar."</p>
          </div>
        </div>

        <div class="for-who-cta reveal">
          <p class="for-who-message">
            Se você se identificou, o <strong>Fundamentos da Tatuagem</strong> é exatamente o que você precisa. Em poucas aulas você aprende os pilares reais da profissão, sem enrolação.
          </p>
          <a href={WA_LINK} target="_blank" rel="noopener" class="cta-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Quero saber mais
          </a>
        </div>
      </div>
    </section>

    <!-- ─── GRADE DE AULAS (DARK) ────────────────────────── -->
    <section class="aulas-section dark-section section">
      <div class="container">
        <div class="section-header center">
          <span class="section-label-gold">Conteúdo do curso</span>
          <h2 class="section-title">5 aulas. 5 pilares. O começo certo.</h2>
          <p class="section-sub">Cada aula combina teoria essencial com prática no artificial. Você já sai praticando desde a primeira aula.</p>
        </div>

        <div class="aulas-grid">
          {aulas.map((aula, i) => (
            <div class="aula-card reveal" style={`transition-delay: ${i * 0.08}s`}>
              <div class="aula-header">
                <span class="aula-day">{aula.day}</span>
                <div class="aula-icon" set:html={aula.icon}></div>
              </div>
              <h3 class="aula-title">{aula.title}</h3>
              <ul class="aula-items">
                {aula.items.map(item => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="aulas-cta reveal">
          <a href={WA_LINK} target="_blank" rel="noopener" class="cta-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Quero garantir minha vaga
          </a>
        </div>
      </div>
    </section>

    <!-- ─── PROFESSORES (DARK) ─────────────────────────── -->
    <Instructors />

    <!-- ─── O QUE ESTÁ INCLUSO (LIGHT) ──────────────────── -->
    <section class="includes-section light-section">
      <div class="container includes-inner">
        <div class="includes-text reveal">
          <span class="section-label-gold">O que você leva</span>
          <h2 class="section-title dark-text">Tudo que você precisa para começar</h2>
          <p class="includes-desc dark-text-dim">
            Nada de enrolação. Cada item do curso foi pensado para te dar uma base sólida e economizar seu dinheiro lá na frente.
          </p>

          <ul class="includes-list">
            {includes.map((item) => (
              <li class="include-item reveal">
                <div class="include-icon" set:html={item.icon}></div>
                <span>{item.text}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bonus-card reveal">
          <div class="bonus-tag">BÔNUS</div>
          <div class="bonus-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 12h4l3 8 4-16 3 8h4"/>
            </svg>
          </div>
          <h3 class="bonus-title">Mapa de Estudos</h3>
          <p class="bonus-desc">
            Um plano semana a semana com o que praticar depois do curso, para você evoluir em casa sem perder tempo e sem ficar travado sem saber o que fazer.
          </p>
          <div class="bonus-weeks">
            <div class="week-item">
              <span class="week-label">Semana 1</span>
              <span>Prática de traço</span>
            </div>
            <div class="week-item">
              <span class="week-label">Semana 2</span>
              <span>Sombra sólida e Whip Shade</span>
            </div>
            <div class="week-item">
              <span class="week-label">Semana 3</span>
              <span>Preenchimento colorido</span>
            </div>
            <div class="week-item">
              <span class="week-label">Semana 4+</span>
              <span>Projetos livres guiados</span>
            </div>
          </div>
          <p class="bonus-note">
            Também inclui a <strong>lista de materiais certos</strong>: saia sabendo exatamente o que comprar e pare de desperdiçar dinheiro com equipamento errado.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── KIT PARA PRATICAR EM CASA (DARK) ─────────────── -->
    <section class="kit-section dark-section section">
      <div class="container kit-inner">
        <div class="kit-content reveal">
          <span class="section-label-gold">Diferencial exclusivo</span>
          <h2 class="section-title">Leve um kit para casa<br/>e pratique entre as aulas</h2>
          <p class="section-sub kit-sub">
            Durante o curso, você recebe em consignação uma máquina e os materiais básicos para treinar em casa, no seu ritmo, aplicando o que aprendeu em cada aula.
          </p>

          <ul class="kit-list">
            <li>
